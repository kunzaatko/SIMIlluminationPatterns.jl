@article{zheng2021,
  title = {Current Challenges and Solutions of Super-Resolution Structured Illumination Microscopy},
  author = {Zheng, Xiaomin and Zhou, Jie and Wang, Lei and Wang, Meiting and Wu, Wenshuai and Chen, Jiajie and Qu, Junle and Gao, Bruce Zhi and Shao, Yonghong},
  year = {2021},
