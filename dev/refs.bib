  file = {/home/kunzaatko/Zotero/storage/BAVTAUSZ/Smal et al. - 2010 - Quantitative Comparison of Spot Detection Methods .pdf;/home/kunzaatko/Zotero/storage/ABM7TYWL/5109713.html}
