@article{perez2016,
  title = {Optimal {{2D-SIM}} Reconstruction by Two Filtering Steps with {{Richardson-Lucy}} Deconvolution},
  author = {Perez, Victor and Chang, Bo-Jui and Stelzer, Ernst Hans Karl},
