@inproceedings{gustafsson2000a,
  title = {Doubling the Lateral Resolution of Wide-Field Fluorescence Microscopy Using Structured Illumination},
  booktitle = {Three-{{Dimensional}} and {{Multidimensional Microscopy}}: {{Image Acquisition Processing VII}}},
