  file = {/home/kunzaatko/Zotero/storage/L7WZ2EUR/Lefkimmiatis et al. - 2012 - Hessian-Based Norm Regularization for Image Restor.pdf;/home/kunzaatko/Zotero/storage/78TKSTAJ/6021369.html}
}
