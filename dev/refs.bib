  title = {Computational {{Image Analysis}} of {{Cellular Dynamics}}: {{A Case Study Based}} on {{Particle Tracking}}},
  shorttitle = {Computational {{Image Analysis}} of {{Cellular Dynamics}}},
  author = {Jaqaman, Khuloud and Danuser, Gaudenz},
  year = {2009},
