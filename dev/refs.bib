@article{dan2021,
  title = {Rapid {{Image Reconstruction}} of {{Structured Illumination Microscopy Directly}} in the {{Spatial Domain}}},
  author = {Dan, Dan and Wang, Zhaojun and Zhou, Xing and Lei, Ming and Zhao, Tianyu and Qian, Jia and Yu, Xianghua and Yan, Shaohui and Min, Junwei and Bianco, Piero R. and Yao, Baoli},
  year = {2021},
