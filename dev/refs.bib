@inproceedings{lukes2014,
  title = {Comparison of Image Reconstruction Methods for Structured Illumination Microscopy},
  booktitle = {Biophotonics: {{Photonic Solutions}} for {{Better Health Care IV}}},
  author = {Luke{\v s}, Tomas and Hagen, Guy M. and K{\v r}{\'i}{\v z}ek, Pavel and {\v S}vindrych, Zden{\v e}k and Fliegel, Karel and Kl{\'i}ma, Milo{\v s}},
  year = {2014},
