@article{lefkimmiatis2012,
  title = {Hessian-{{Based Norm Regularization}} for {{Image Restoration With Biomedical Applications}}},
  author = {Lefkimmiatis, Stamatios and Bourquard, Aur{\'e}lien and Unser, Michael},
  year = {2012},
